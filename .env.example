# Copy to .env — the CLI loads it at startup; real environment variables win.
# Needed only for --judge openai and prompt generation. Everything else
# (consistency, similarity, --judge overlap, the offline demo) runs without it.

OPENAI_API_KEY=sk-...

# Optional overrides
#JUDGE_MODEL=gpt-4o-mini
#PROMPT_MODEL=gpt-4o-mini
#OPENAI_BASE_URL=http://localhost:8000/v1   # any OpenAI-compatible server
#HF_TOKEN=hf_...                            # only for private/gated repos
